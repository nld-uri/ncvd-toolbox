% ---------------------------------------------------------------- fonts
% Order of preference:
%  XeLaTeX/LuaLaTeX: (1) IBM Plex installed on the system,
%                    (2) Plex OTFs from TeX Live (plex package),
%                    (3) the TTFs shipped in ./fonts/,
%                    (4) Latin Modern.
%  pdfLaTeX:         plex-sans/plex-serif/plex-mono packages if present, else Latin Modern.
% Mathematics always uses Computer Modern / Latin Modern Math.
\newif\ifnld@plex \nld@plexfalse
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \IfFileExists{plex-serif.sty}{%
    \RequirePackage{plex-sans}%
    \RequirePackage{plex-serif}%
    \RequirePackage{plex-mono}%
    \nld@plextrue}{%
    \RequirePackage{lmodern}%
    \PackageWarning{nld-style}{IBM Plex not found; using Latin Modern}}
\else
  \RequirePackage{fontspec}
  \RequirePackage{unicode-math}
  % Load the math font by file name first: XeTeX on macOS does not see TeX Live fonts by family name
  \IfFontExistsTF{latinmodern-math.otf}{\setmathfont{latinmodern-math.otf}}{%
    \IfFontExistsTF{Latin Modern Math}{\setmathfont{Latin Modern Math}}{%
      \PackageWarning{nld-style}{Latin Modern Math not found; using the default math font}}}
  \def\nld@setplex#1#2{% #1 = family file stem, #2 = command
    \IfFontExistsTF{#1-Regular.otf}{%
      #2{#1}[Extension=.otf, UprightFont=*-Regular, ItalicFont=*-Italic,
             BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic]\nld@plextrue}{%
    \IfFontExistsTF{fonts/#1-Regular.ttf}{%
      #2{#1}[Path=fonts/, Extension=.ttf, UprightFont=*-Regular, ItalicFont=*-Italic,
             BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic]\nld@plextrue}{}}}
  \IfFontExistsTF{IBM Plex Sans}{%
    \IfFontExistsTF{IBM Plex Sans SemiBold}{%
      \setsansfont{IBM Plex Sans}[BoldFont={IBM Plex Sans SemiBold}, BoldItalicFont={IBM Plex Sans SemiBold Italic}]}{%
      \setsansfont{IBM Plex Sans}}%
    \IfFontExistsTF{IBM Plex Serif SemiBold}{%
      \setmainfont{IBM Plex Serif}[BoldFont={IBM Plex Serif SemiBold}, BoldItalicFont={IBM Plex Serif SemiBold Italic}]}{%
      \setmainfont{IBM Plex Serif}}%
    \setmonofont{IBM Plex Mono}%
    \nld@plextrue}{%
    \nld@setplex{IBMPlexSans}{\setsansfont}%
    \nld@setplex{IBMPlexSerif}{\setmainfont}%
    \IfFontExistsTF{IBMPlexMono-Regular.otf}{\setmonofont{IBMPlexMono}[Extension=.otf, UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-Medium]}{%
      \IfFontExistsTF{fonts/IBMPlexMono-Regular.ttf}{\setmonofont{IBMPlexMono}[Path=fonts/, Extension=.ttf, UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-Medium]}{}}}
  \ifnld@plex\else\PackageWarning{nld-style}{IBM Plex not found; using Latin Modern}\fi
\fi

% Uppercase tracked label, as in the lockup ("eyebrow")
\newcommand{\nldeyebrowcolor}{nldmuted}
\newcommand{\nldeyebrow}[1]{{\sffamily\footnotesize\color{\nldeyebrowcolor}%
  \textcolor{nldcopper}{\rule[0.3ex]{1.6em}{0.28ex}}\hspace{0.6em}%
  \nld@track{\MakeUppercase{#1}}}}
\ifPDFTeX
  \IfFileExists{microtype.sty}{%
    \RequirePackage{microtype}%
    \newcommand{\nld@track}[1]{\textls[120]{#1}}}{%
    \newcommand{\nld@track}[1]{#1}}
\else
  \newcommand{\nld@track}[1]{{\addfontfeature{LetterSpace=12}#1}}
\fi

\endinput
